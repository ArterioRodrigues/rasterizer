# Unit cube centered at origin
# 8 vertices, 12 triangle faces (2 per side)

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

# Faces (counter-clockwise winding when viewed from outside)
# Back face (-Z)
f 1 3 2
f 1 4 3

# Front face (+Z)
f 5 6 7
f 5 7 8

# Left face (-X)
f 1 5 8
f 1 8 4

# Right face (+X)
f 2 3 7
f 2 7 6

# Bottom face (-Y)
f 1 2 6
f 1 6 5

# Top face (+Y)
f 4 8 7
f 4 7 3
