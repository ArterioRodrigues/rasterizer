# Unit cube centered at origin
# 8 vertices, 12 triangle faces (2 per side)

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

# UV coordinates (same 4 used per face, repeated for each face)
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Format: f vertex/uv  vertex/uv  vertex/uv

# Back face (-Z)
f 1/1 3/3 2/2
f 1/1 4/4 3/3

# Front face (+Z)
f 5/1 6/2 7/3
f 5/1 7/3 8/4

# Left face (-X)
f 1/1 5/2 8/3
f 1/1 8/3 4/4

# Right face (+X)
f 2/1 3/2 7/3
f 2/1 7/3 6/4

# Bottom face (-Y)
f 1/1 2/2 6/3
f 1/1 6/3 5/4

# Top face (+Y)
f 4/1 8/2 7/3
f 4/1 7/3 3/4
